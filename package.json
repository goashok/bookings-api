{
  "name": "bookings-api",
  "version": "0.1.0",
  "private": true,
  "description": "Bookings for venues: tables, rooms and the times people book them.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "migrate": "node src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
